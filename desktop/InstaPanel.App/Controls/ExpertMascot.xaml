<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="InstaPanel.App.Controls.ExpertMascot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Tico, o especialista do Cronos">

    <!--  Tico: um relógio-despertador simpático nas cores do ícone do Cronos (índigo → ciano).  -->
    <Viewbox>
        <Canvas
            x:Name="Root"
            Width="124"
            Height="132">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="Bob" />
            </Canvas.RenderTransform>

            <!--  Sombra no chão (fica parada enquanto o corpo flutua)  -->
            <Ellipse
                x:Name="GroundShadow"
                Canvas.Left="32"
                Canvas.Top="122"
                Width="60"
                Height="8"
                Fill="#000000"
                Opacity="0.14" />

            <!--  Sinos do despertador  -->
            <Canvas x:Name="Bells">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="BellShake" CenterX="62" CenterY="40" />
                </Canvas.RenderTransform>
                <Ellipse
                    Canvas.Left="12"
                    Canvas.Top="8"
                    Width="30"
                    Height="30"
                    Fill="#4338CA" />
                <Ellipse
                    Canvas.Left="82"
                    Canvas.Top="8"
                    Width="30"
                    Height="30"
                    Fill="#0891B2" />
                <Ellipse
                    Canvas.Left="19"
                    Canvas.Top="13"
                    Width="9"
                    Height="6"
                    Fill="#FFFFFF"
                    Opacity="0.35" />
                <Ellipse
                    Canvas.Left="89"
                    Canvas.Top="13"
                    Width="9"
                    Height="6"
                    Fill="#FFFFFF"
                    Opacity="0.35" />
                <Rectangle
                    Canvas.Left="57"
                    Canvas.Top="6"
                    Width="10"
                    Height="12"
                    Fill="#312E81"
                    RadiusX="3"
                    RadiusY="3" />
            </Canvas>

            <!--  Pés  -->
            <Rectangle
                Canvas.Left="38"
                Canvas.Top="110"
                Width="18"
                Height="11"
                Fill="#312E81"
                RadiusX="5"
                RadiusY="5" />
            <Rectangle
                Canvas.Left="68"
                Canvas.Top="110"
                Width="18"
                Height="11"
                Fill="#155E75"
                RadiusX="5"
                RadiusY="5" />

            <!--  Corpo  -->
            <Ellipse
                Canvas.Left="12"
                Canvas.Top="18"
                Width="100"
                Height="100">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#4F46E5" />
                        <GradientStop Offset="1" Color="#06B6D4" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!--  Braço esquerdo (parado)  -->
            <Rectangle
                Canvas.Left="0"
                Canvas.Top="74"
                Width="22"
                Height="10"
                Fill="#4338CA"
                RadiusX="5"
                RadiusY="5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="24" CenterX="20" CenterY="5" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <!--  Braço direito (acena)  -->
            <Canvas>
                <Canvas.RenderTransform>
                    <RotateTransform
                        x:Name="ArmWave"
                        Angle="-28"
                        CenterX="104"
                        CenterY="72" />
                </Canvas.RenderTransform>
                <Rectangle
                    Canvas.Left="102"
                    Canvas.Top="67"
                    Width="22"
                    Height="10"
                    Fill="#0891B2"
                    RadiusX="5"
                    RadiusY="5" />
                <Ellipse
                    Canvas.Left="114"
                    Canvas.Top="63"
                    Width="10"
                    Height="10"
                    Fill="#06B6D4" />
            </Canvas>

            <!--  Mostrador  -->
            <Ellipse
                Canvas.Left="23"
                Canvas.Top="29"
                Width="78"
                Height="78"
                Fill="#FFFFFF" />
            <Rectangle
                Canvas.Left="60"
                Canvas.Top="33"
                Width="4"
                Height="8"
                Fill="#C7D2FE"
                RadiusX="2"
                RadiusY="2" />
            <Rectangle
                Canvas.Left="60"
                Canvas.Top="95"
                Width="4"
                Height="8"
                Fill="#C7D2FE"
                RadiusX="2"
                RadiusY="2" />
            <Rectangle
                Canvas.Left="27"
                Canvas.Top="66"
                Width="8"
                Height="4"
                Fill="#C7D2FE"
                RadiusX="2"
                RadiusY="2" />
            <Rectangle
                Canvas.Left="89"
                Canvas.Top="66"
                Width="8"
                Height="4"
                Fill="#C7D2FE"
                RadiusX="2"
                RadiusY="2" />

            <!--  Bochechas  -->
            <Ellipse
                Canvas.Left="31"
                Canvas.Top="76"
                Width="11"
                Height="6"
                Fill="#F472B6"
                Opacity="0.45" />
            <Ellipse
                Canvas.Left="82"
                Canvas.Top="76"
                Width="11"
                Height="6"
                Fill="#F472B6"
                Opacity="0.45" />

            <!--  Olhos (piscam)  -->
            <Canvas x:Name="Eyes">
                <Canvas.RenderTransform>
                    <CompositeTransform
                        x:Name="EyesTransform"
                        CenterX="62"
                        CenterY="63" />
                </Canvas.RenderTransform>
                <Ellipse
                    Canvas.Left="46"
                    Canvas.Top="58"
                    Width="8"
                    Height="10"
                    Fill="#1E1B4B" />
                <Ellipse
                    Canvas.Left="70"
                    Canvas.Top="58"
                    Width="8"
                    Height="10"
                    Fill="#1E1B4B" />
                <Ellipse
                    Canvas.Left="49"
                    Canvas.Top="59.5"
                    Width="3"
                    Height="3"
                    Fill="#FFFFFF" />
                <Ellipse
                    Canvas.Left="73"
                    Canvas.Top="59.5"
                    Width="3"
                    Height="3"
                    Fill="#FFFFFF" />
            </Canvas>

            <!--  Óculos de especialista  -->
            <Ellipse
                Canvas.Left="38"
                Canvas.Top="51"
                Width="24"
                Height="24"
                Stroke="#1E1B4B"
                StrokeThickness="2.5" />
            <Ellipse
                Canvas.Left="62"
                Canvas.Top="51"
                Width="24"
                Height="24"
                Stroke="#1E1B4B"
                StrokeThickness="2.5" />
            <Line
                Stroke="#1E1B4B"
                StrokeThickness="2.5"
                X1="59"
                X2="65"
                Y1="61"
                Y2="61" />

            <!--  Boca: uma por humor  -->
            <Path
                x:Name="MouthHappy"
                Data="M 52,84 Q 62,95 72,84"
                Stroke="#1E1B4B"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="3" />
            <Path
                x:Name="MouthNeutral"
                Data="M 55,88 Q 62,91 69,88"
                Stroke="#1E1B4B"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="3"
                Visibility="Collapsed" />
            <Path
                x:Name="MouthWorried"
                Data="M 53,91 Q 62,83 71,91"
                Stroke="#1E1B4B"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="3"
                Visibility="Collapsed" />
            <Ellipse
                x:Name="MouthThinking"
                Canvas.Left="58"
                Canvas.Top="85"
                Width="8"
                Height="8"
                Stroke="#1E1B4B"
                StrokeThickness="2.5"
                Visibility="Collapsed" />
        </Canvas>
    </Viewbox>
</UserControl>
