<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="InstaPanel.App.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InstaPanel.App.Pages"
    xmlns:vm="using:InstaPanel.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!--  Mês: cartão de uma linha (horário, estado e legenda)  -->
        <DataTemplate x:Key="MonthChipTemplate" x:DataType="vm:PostItemViewModel">
            <Grid
                Height="24"
                Margin="0,0,0,3"
                Padding="0,0,6,0"
                AutomationProperties.Name="{x:Bind ChipText}"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CanDrag="{x:Bind IsEditable}"
                ColumnSpacing="4"
                CornerRadius="4"
                DragStarting="Chip_DragStarting"
                Opacity="{x:Bind ChipOpacity}"
                Tag="{x:Bind}"
                Tapped="Chip_Tapped"
                ToolTipService.ToolTip="{x:Bind ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{x:Bind StateBrush}" CornerRadius="4,0,0,4" />
                <FontIcon
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    FontSize="11"
                    Glyph="{x:Bind TypeGlyph}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{x:Bind TimeText}" />
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontSize="12"
                    MaxLines="1"
                    Text="{x:Bind Caption}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!--  Semana: miniatura em cima, texto embaixo (as colunas são estreitas)  -->
        <DataTemplate x:Key="WeekChipTemplate" x:DataType="vm:PostItemViewModel">
            <Grid
                Margin="0,0,0,6"
                AutomationProperties.Name="{x:Bind ChipText}"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{x:Bind StateBrush}"
                BorderThickness="0,3,0,0"
                CanDrag="{x:Bind IsEditable}"
                CornerRadius="4"
                DragStarting="Chip_DragStarting"
                Opacity="{x:Bind ChipOpacity}"
                Tag="{x:Bind}"
                Tapped="Chip_Tapped"
                ToolTipService.ToolTip="{x:Bind ToolTip}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                    <FontIcon
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="{x:Bind TypeGlyph}"
                        Visibility="{x:Bind HasNoThumbnail}" />
                </Grid>
                <StackPanel Grid.Row="1" Padding="6,4,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="11" Glyph="{x:Bind TypeGlyph}" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{x:Bind TimeText}" />
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        MaxLines="2"
                        Text="{x:Bind Caption}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind StateText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <local:ChipTemplateSelector
            x:Key="ChipSelector"
            Month="{StaticResource MonthChipTemplate}"
            Week="{StaticResource WeekChipTemplate}" />

        <UniformGridLayout
            x:Key="DaysLayout"
            ItemsStretch="Fill"
            MaximumRowsOrColumns="7"
            MinColumnSpacing="6"
            MinItemHeight="122"
            MinItemWidth="56"
            MinRowSpacing="6" />
        <!--  Mesma largura mínima da grade de dias, para os nomes ficarem alinhados às colunas  -->
        <UniformGridLayout
            x:Key="HeaderLayout"
            ItemsStretch="Fill"
            MaximumRowsOrColumns="7"
            MinColumnSpacing="6"
            MinItemHeight="20"
            MinItemWidth="56" />
    </Page.Resources>

    <Grid Padding="36,24,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Cabeçalho  -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            </StackPanel>
            <ProgressRing
                Grid.Column="1"
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <SelectorBar
                x:Name="ModeBar"
                Grid.Column="2"
                VerticalAlignment="Center"
                SelectionChanged="ModeBar_SelectionChanged">
                <SelectorBarItem IsSelected="True" Tag="month" Text="Mês" />
                <SelectorBarItem Tag="week" Text="Semana" />
            </SelectorBar>
            <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                AutomationProperties.Name="Anterior"
                Command="{x:Bind ViewModel.PreviousCommand}"
                ToolTipService.ToolTip="Anterior">
                <FontIcon FontSize="14" Glyph="&#xE76B;" />
            </Button>
            <Button
                Grid.Column="4"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.TodayCommand}"
                Content="Hoje" />
            <Button
                Grid.Column="5"
                VerticalAlignment="Center"
                AutomationProperties.Name="Próximo"
                Command="{x:Bind ViewModel.NextCommand}"
                ToolTipService.ToolTip="Próximo">
                <FontIcon FontSize="14" Glyph="&#xE76C;" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                x:Name="MoveError"
                Title="Não foi possível remarcar"
                Severity="Warning" />
        </StackPanel>

        <ItemsRepeater
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.WeekdayNames}"
            Layout="{StaticResource HeaderLayout}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock
                        Padding="8,0"
                        Style="{StaticResource CardCaptionStyle}"
                        Text="{x:Bind}" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <ScrollViewer
            x:Name="DaysScroll"
            Grid.Row="3"
            Padding="0,0,0,24">
            <ItemsRepeater
                x:Name="DaysRepeater"
                ItemsSource="{x:Bind ViewModel.Days}"
                Layout="{StaticResource DaysLayout}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarDayViewModel">
                        <Border
                            Padding="6"
                            AllowDrop="True"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            DragLeave="Day_DragLeave"
                            DragOver="Day_DragOver"
                            Drop="Day_Drop"
                            Opacity="{x:Bind DayOpacity}"
                            Tag="{x:Bind}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock
                                        Padding="4,0"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind DayNumber}"
                                        Visibility="{x:Bind IsNotToday}" />
                                    <Border
                                        MinWidth="24"
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="12"
                                        Visibility="{x:Bind IsToday}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{x:Bind DayNumber}" />
                                    </Border>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardCaptionStyle}"
                                        Text="{x:Bind WeekHeader}"
                                        Visibility="{x:Bind ShowWeekHeader}" />
                                </Grid>
                                <ItemsControl ItemTemplateSelector="{StaticResource ChipSelector}" ItemsSource="{x:Bind VisiblePosts}" />
                                <HyperlinkButton
                                    Padding="4,0"
                                    Click="More_Click"
                                    Content="{x:Bind MoreText}"
                                    FontSize="12"
                                    Tag="{x:Bind}"
                                    Visibility="{x:Bind HasMore}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
