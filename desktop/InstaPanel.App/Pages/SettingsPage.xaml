<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="InstaPanel.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900" />
            </Grid.ColumnDefinitions>
        <StackPanel
            Padding="36,24,36,36"
            Spacing="4">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Configurações" />
                <ProgressRing
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </Grid>

            <InfoBar
                Margin="0,12,0,0"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.StatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

            <!--  Worker  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Conexão com o Worker" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBox
                        Header="URL do Worker"
                        PlaceholderText="https://instapanel.seu-subdominio.workers.dev"
                        Text="{x:Bind ViewModel.WorkerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Spacing="4">
                        <PasswordBox
                            Header="Chave do painel"
                            Password="{x:Bind ViewModel.PanelKey, Mode=TwoWay}"
                            PasswordRevealMode="Peek" />
                        <TextBlock
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{x:Bind ViewModel.KeySourceText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Command="{x:Bind ViewModel.SaveAndTestCommand}"
                        Content="Salvar e testar conexão"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <!--  Conta  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Conta Instagram" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE77B;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.AccountText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="2"
                            Click="Disconnect_Click"
                            Content="Desconectar"
                            IsEnabled="{x:Bind ViewModel.IsAccountConnected, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Spacing="6">
                        <Button
                            AutomationProperties.Name="Entrar com Instagram"
                            Click="InstagramLogin_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8D7;" />
                                <TextBlock Text="Entrar com Instagram" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            Style="{StaticResource CardCaptionStyle}"
                            Text="Abre o login da Meta aqui dentro do painel. Use também para renovar a conexão ou trocar de conta."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Header="Avançado: colar um token de acesso">
                        <StackPanel Spacing="8">
                            <PasswordBox
                                Header="Token de acesso da Meta"
                                Password="{x:Bind ViewModel.NewToken, Mode=TwoWay}"
                                PasswordRevealMode="Peek" />
                            <TextBlock
                                Style="{StaticResource CardCaptionStyle}"
                                Text="Gerado no painel de desenvolvedor da Meta. Vai direto para o Worker, que valida e guarda criptografado. Não fica salvo neste PC."
                                TextWrapping="Wrap" />
                            <Button Command="{x:Bind ViewModel.ConnectTokenCommand}" Content="Conectar token" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!--  Notificações  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Notificações do Windows" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Avisa quando um post agendado é publicado ou falha (com o painel aberto ou ao abrir de novo)." TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="NotificationStatus"
                            Style="{StaticResource CardCaptionStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="TestNotification_Click"
                        Content="Enviar notificação de teste" />
                </Grid>
            </Border>

            <!--  Atualizações  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Atualizações" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="VersionLabel" />
                            <TextBlock
                                x:Name="UpdateStatus"
                                Style="{StaticResource CardCaptionStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="UpdateButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="Update_Click"
                            Content="Procurar atualizações" />
                    </Grid>
                    <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!--  Sobre  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Sobre" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.VersionText}" />
                        <TextBlock
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{x:Bind ViewModel.DataDirectory}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="OpenDataFolder_Click"
                        Content="Abrir pasta de dados" />
                </Grid>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
