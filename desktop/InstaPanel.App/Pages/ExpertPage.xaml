<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="InstaPanel.App.Pages.ExpertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InstaPanel.App.Controls"
    xmlns:vm="using:InstaPanel.App.ViewModels">

    <Page.Resources>
        <!--  Títulos de seção: grandes e com uma linha explicando o que é  -->
        <Style x:Key="ExpertSectionTitle" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="PillText" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  Indicador do resumo  -->
        <DataTemplate x:Key="StatTemplate" x:DataType="vm:ExpertStatViewModel">
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind Glyph}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}" Text="{x:Bind Label}" />
                    </StackPanel>
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="{x:Bind Value}" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Foreground="{x:Bind ToneBrush}"
                            Glyph="{x:Bind ToneGlyph}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Meaning}"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  Passo numerado de "Comece por aqui"  -->
        <DataTemplate x:Key="StepTemplate" x:DataType="vm:ExpertStepViewModel">
            <Border
                Padding="18"
                AutomationProperties.Name="{x:Bind Title}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="36"
                        Height="36"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="18">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Text="{x:Bind Number}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Padding="8,2"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="11" Glyph="{x:Bind AreaGlyph}" />
                                    <TextBlock Style="{StaticResource PillText}" Text="{x:Bind Area}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Padding="8,2"
                                Background="{x:Bind LevelBackground}"
                                CornerRadius="10">
                                <TextBlock
                                    Foreground="{x:Bind LevelBrush}"
                                    Style="{StaticResource PillText}"
                                    Text="{x:Bind LevelText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Action}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Bloco de área do Raio-X (clicável)  -->
        <DataTemplate x:Key="AreaTemplate" x:DataType="vm:ExpertAreaViewModel">
            <Button
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind AutomationName}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{x:Bind TileBorder, Mode=OneWay}"
                BorderThickness="2"
                Click="AreaTile_Click"
                CornerRadius="8">
                <Grid Padding="14,12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="32"
                            Height="32"
                            Background="{x:Bind GradeBackground}"
                            CornerRadius="16">
                            <FontIcon
                                FontSize="15"
                                Foreground="{x:Bind GradeBrush}"
                                Glyph="{x:Bind Glyph}" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind GradeBrush}"
                            Text="{x:Bind ScoreText}" />
                    </Grid>
                    <ProgressBar
                        Grid.Row="1"
                        Foreground="{x:Bind GradeBrush}"
                        Maximum="100"
                        Value="{x:Bind Score}" />
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource CardCaptionStyle}"
                            Text="{x:Bind StatusText}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{x:Bind GradeBrush}"
                            Style="{StaticResource PillText}"
                            Text="{x:Bind GradeText}" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="MetricChipTemplate" x:DataType="vm:ExpertMetricViewModel">
            <Border
                Padding="12,10"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6">
                <StackPanel Spacing="2">
                    <TextBlock
                        Style="{StaticResource CardCaptionStyle}"
                        Text="{x:Bind Label}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Value}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Style="{StaticResource CardCaptionStyle}"
                        Text="{x:Bind Note}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasNote}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  Achado "para melhorar": cartão com o passo em destaque  -->
        <DataTemplate x:Key="ImproveTemplate" x:DataType="vm:ExpertFindingViewModel">
            <Grid
                AutomationProperties.Name="{x:Bind Title}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="{x:Bind Brush}" />
                <StackPanel
                    Grid.Column="1"
                    Padding="14,12"
                    Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="{x:Bind Brush}"
                            Glyph="{x:Bind Glyph}" />
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Detail}"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="10,8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Visibility="{x:Bind HasAction}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE76C;" />
                            <TextBlock
                                Grid.Column="1"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Como fazer: " />
                                <Run Text="{x:Bind Action}" />
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--  Achado curto ("está funcionando" e "bom saber")  -->
        <DataTemplate x:Key="NoteTemplate" x:DataType="vm:ExpertFindingViewModel">
            <Grid AutomationProperties.Name="{x:Bind Title}" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Margin="0,3,0,0"
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{x:Bind Brush}"
                    Glyph="{x:Bind Glyph}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Detail}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--  Dia do plano da semana  -->
        <DataTemplate x:Key="PlanDayTemplate" x:DataType="vm:ExpertPlanDayViewModel">
            <Grid
                Padding="14,12"
                AutomationProperties.Name="{x:Bind AutomationName}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="16"
                CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DayName}" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{x:Bind DateText}" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="20">
                    <FontIcon
                        FontSize="17"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="{x:Bind FormatGlyph}" />
                </Border>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind FormatAndTime}" />
                        <Border
                            Padding="8,1"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind HasGoal}">
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource PillText}"
                                Text="{x:Bind GoalText}" />
                        </Border>
                        <Border
                            Padding="8,1"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind HasAlreadyPlanned}">
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource PillText}"
                                Text="{x:Bind AlreadyPlanned}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Idea}" TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Inspiration}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasInspiration}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--  Melhor post  -->
        <DataTemplate x:Key="TopPostTemplate" x:DataType="vm:ExpertTopPostViewModel">
            <Border
                AutomationProperties.Name="{x:Bind Caption}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Height="190">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8,8,0,0">
                            <FontIcon
                                FontSize="28"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="{x:Bind TypeGlyph}" />
                        </Border>
                        <Border CornerRadius="8,8,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border
                            Margin="8"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            CornerRadius="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="11" Glyph="{x:Bind TypeGlyph}" />
                                <TextBlock Style="{StaticResource PillText}" Text="{x:Bind TypeText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Padding="12" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind InteractionsText}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind VsMedianText}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Caption}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,4,0,0">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardCaptionStyle}"
                                Text="{x:Bind DateText}" />
                            <HyperlinkButton
                                Padding="4,2"
                                HorizontalAlignment="Right"
                                Content="Abrir"
                                NavigateUri="{x:Bind Permalink}"
                                Visibility="{x:Bind HasPermalink}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="PageScroll" ViewChanged="PageScroll_ViewChanged">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1100" />
                </Grid.ColumnDefinitions>
                <!--  Margem de baixo grande: o Tico fica no canto e não pode cobrir o fim da página  -->
                <StackPanel Padding="36,24,36,220" Spacing="18">

                    <!--  Cabeçalho  -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Especialista" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Seu perfil analisado com os seus dados reais, em linguagem simples."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="190"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Objetivo do perfil"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            PlaceholderText="Objetivo"
                            SelectedIndex="{x:Bind ViewModel.SelectedGoalIndex, Mode=TwoWay}"
                            ToolTipService.ToolTip="Seu objetivo muda as dicas de link, posts fixados e promoção">
                            <x:String>Crescer em seguidores</x:String>
                            <x:String>Vender um produto</x:String>
                            <x:String>Conseguir clientes</x:String>
                            <x:String>Construir autoridade</x:String>
                        </ComboBox>
                        <ProgressRing
                            Grid.Column="2"
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Copiar relatório"
                            Click="Copy_Click"
                            IsEnabled="{x:Bind ViewModel.HasReport, Mode=OneWay}"
                            ToolTipService.ToolTip="Copia o relatório completo (em Markdown)">
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        </Button>
                        <Button
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.AnalyzeCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <TextBlock Text="Analisar de novo" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <InfoBar
                        Title="Configure o painel"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.NeedsSetup, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.NeedsSetup, Mode=OneWay}"
                        Message="Informe a URL do Worker e a chave do painel para o especialista ler sua conta."
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button Click="OpenSettings_Click" Content="Abrir Configurações" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar
                        Title="Não foi possível analisar"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error" />

                    <InfoBar
                        x:Name="CopiedBar"
                        Closed="CopiedBar_Closed"
                        Visibility="Collapsed"
                        Title="Relatório copiado"
                        Message="Cole onde quiser (Notion, Word, WhatsApp...)."
                        Severity="Success" />

                    <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay}">

                        <!--  1. Resumo  -->
                        <Border Style="{StaticResource CardStyle}" Padding="24">
                            <StackPanel Spacing="22">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Width="112"
                                        Height="112"
                                        AutomationProperties.Name="Nota geral">
                                        <ProgressRing
                                            Width="112"
                                            Height="112"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Foreground="{x:Bind ViewModel.GradeBrush, Mode=OneWay}"
                                            IsIndeterminate="False"
                                            Maximum="100"
                                            Value="{x:Bind ViewModel.Score, Mode=OneWay}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="34"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}" />
                                            <TextBlock
                                                Margin="0,-4,0,0"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource CardCaptionStyle}"
                                                Text="de 100" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border
                                                Padding="10,3"
                                                Background="{x:Bind ViewModel.GradeBackground, Mode=OneWay}"
                                                CornerRadius="12">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind ViewModel.GradeBrush, Mode=OneWay}"
                                                    Text="{x:Bind ViewModel.GradeText, Mode=OneWay}" />
                                            </Border>
                                            <PersonPicture
                                                Width="28"
                                                Height="28"
                                                DisplayName="{x:Bind ViewModel.Username, Mode=OneWay}"
                                                ProfilePicture="{x:Bind ViewModel.ProfilePicture, Mode=OneWay}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ViewModel.Username, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Headline, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Style="{StaticResource CardCaptionStyle}"
                                            Text="{x:Bind ViewModel.AnalyzedText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <ItemsRepeater ItemTemplate="{StaticResource StatTemplate}" ItemsSource="{x:Bind ViewModel.Stats}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MinColumnSpacing="12"
                                            MinItemWidth="200"
                                            MinRowSpacing="12" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <!--  2. Comece por aqui  -->
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource ExpertSectionTitle}" Text="Comece por aqui" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Os passos que mais fazem diferença agora, em ordem de importância." />
                        </StackPanel>
                        <Border
                            Padding="18"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="8"
                            Visibility="{x:Bind ViewModel.HasNoSteps, Mode=OneWay}">
                            <TextBlock Text="Nenhuma pendência importante. Veja o Raio-X abaixo para os ajustes finos." TextWrapping="Wrap" />
                        </Border>
                        <ItemsRepeater ItemTemplate="{StaticResource StepTemplate}" ItemsSource="{x:Bind ViewModel.Steps}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <ItemsRepeater
                            ItemTemplate="{StaticResource StepTemplate}"
                            ItemsSource="{x:Bind ViewModel.ExtraSteps}"
                            Visibility="{x:Bind ViewModel.ShowExtraSteps, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <HyperlinkButton
                            Margin="-12,-8,0,0"
                            Command="{x:Bind ViewModel.ToggleExtraStepsCommand}"
                            Content="{x:Bind ViewModel.MoreStepsText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowMoreStepsVisible, Mode=OneWay}" />

                        <!--  3. Raio-X  -->
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource ExpertSectionTitle}" Text="Raio-X do perfil" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Cada bloco é uma parte do seu Instagram. Toque em um para ver o que está bom e o que dá para melhorar."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsRepeater ItemTemplate="{StaticResource AreaTemplate}" ItemsSource="{x:Bind ViewModel.Areas}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="12"
                                    MinItemWidth="230"
                                    MinRowSpacing="12" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <!--  Detalhe da área escolhida  -->
                        <Border Style="{StaticResource CardStyle}" Padding="24">
                            <StackPanel Spacing="18">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="44"
                                        Height="44"
                                        Background="{x:Bind ViewModel.SelectedArea.GradeBackground, Mode=OneWay}"
                                        CornerRadius="22">
                                        <FontIcon
                                            FontSize="20"
                                            Foreground="{x:Bind ViewModel.SelectedArea.GradeBrush, Mode=OneWay}"
                                            Glyph="{x:Bind ViewModel.SelectedArea.Glyph, Mode=OneWay}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SelectedArea.Title, Mode=OneWay}" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind ViewModel.SelectedArea.GradeBrush, Mode=OneWay}"
                                            Text="{x:Bind ViewModel.SelectedArea.GradeText, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <!--  Por que importa  -->
                                <Border
                                    Padding="14,12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Margin="0,2,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="16"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xEA80;" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Por que isso importa" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedArea.Why, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ViewModel.SelectedArea.Summary, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!--  Números da área  -->
                                <ItemsRepeater
                                    ItemTemplate="{StaticResource MetricChipTemplate}"
                                    ItemsSource="{x:Bind ViewModel.SelectedArea.Metrics, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.SelectedArea.HasMetrics, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MinColumnSpacing="10"
                                            MinItemWidth="170"
                                            MinRowSpacing="10" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>

                                <!--  Para melhorar  -->
                                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.SelectedArea.HasImprove, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Para melhorar" />
                                    </StackPanel>
                                    <ItemsRepeater ItemTemplate="{StaticResource ImproveTemplate}" ItemsSource="{x:Bind ViewModel.SelectedArea.Improve, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="10" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </StackPanel>
                                <Border
                                    Padding="14,12"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="8"
                                    Visibility="{x:Bind ViewModel.SelectedArea.NothingToImprove, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                        <TextBlock Text="Nada para corrigir aqui. Continue assim!" />
                                    </StackPanel>
                                </Border>

                                <!--  Está funcionando / Bom saber  -->
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.SelectedArea.HasGood, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                FontSize="16"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Glyph="&#xE73E;" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Está funcionando" />
                                        </StackPanel>
                                        <ItemsRepeater ItemTemplate="{StaticResource NoteTemplate}" ItemsSource="{x:Bind ViewModel.SelectedArea.Good, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="12" />
                                            </ItemsRepeater.Layout>
                                        </ItemsRepeater>
                                    </StackPanel>
                                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.SelectedArea.HasKnow, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                FontSize="16"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE946;" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Bom saber" />
                                        </StackPanel>
                                        <ItemsRepeater ItemTemplate="{StaticResource NoteTemplate}" ItemsSource="{x:Bind ViewModel.SelectedArea.Know, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="12" />
                                            </ItemsRepeater.Layout>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedArea.SkillText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!--  4. Análise com IA: só roda quando o usuário clica  -->
                        <Border Style="{StaticResource CardStyle}" Padding="24">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="44"
                                        Height="44"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="22">
                                        <FontIcon
                                            FontSize="20"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Glyph="&#xE945;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Quer ir além? Análise com IA" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="O Claude lê este relatório e seus posts e escreve um diagnóstico, opções de nome e bio, ganchos novos e ideias para a semana. Só roda quando você clica e é cobrado por uso na sua conta da Anthropic."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.AnalyzeWithAiCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanRunAi, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE945;" />
                                            <TextBlock Text="Analisar com IA" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsAiRunning, Mode=OneWay}">
                                    <ProgressBar IsIndeterminate="True" />
                                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="Analisando… pode levar de 1 a 3 minutos." />
                                </StackPanel>
                                <InfoBar
                                    Title="A análise com IA falhou"
                                    IsClosable="False"
                                    IsOpen="{x:Bind ViewModel.HasAiError, Mode=OneWay}"
                                    Message="{x:Bind ViewModel.AiError, Mode=OneWay}"
                                    Severity="Error" />
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasAi, Mode=OneWay}">
                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock
                                        Style="{StaticResource CardCaptionStyle}"
                                        Text="{x:Bind ViewModel.AiInfo, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <RichTextBlock x:Name="AiBlock" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  5. Sua semana  -->
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource ExpertSectionTitle}" Text="Sua semana" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Um plano pronto para os próximos 7 dias, montado com o que funciona no seu perfil. Use só números e fatos reais."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Click="OpenCompose_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock Text="Novo post" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ItemsRepeater ItemTemplate="{StaticResource PlanDayTemplate}" ItemsSource="{x:Bind ViewModel.WeekPlan}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <!--  6. Melhores posts  -->
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource ExpertSectionTitle}" Text="Seus melhores posts" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Os que mais tiveram curtidas e comentários. Vale repetir a ideia em outro formato." />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Sem curtidas visíveis para comparar."
                            Visibility="{x:Bind ViewModel.HasNoTopPosts, Mode=OneWay}" />
                        <ItemsRepeater ItemTemplate="{StaticResource TopPostTemplate}" ItemsSource="{x:Bind ViewModel.TopPosts}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="12"
                                    MinItemWidth="180"
                                    MinRowSpacing="12" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Tico no canto, com o balão de fala  -->
        <Grid
            Margin="0,0,28,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="Bubble"
                Margin="0,0,0,56"
                VerticalAlignment="Bottom"
                Translation="0,0,32"
                Visibility="{x:Bind ViewModel.IsBubbleOpen, Mode=OneWay}">
                <Grid.Shadow>
                    <ThemeShadow />
                </Grid.Shadow>
                <Border
                    Width="320"
                    Padding="16,12,10,14"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Tico" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.MascotCounter, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Fechar o balão do Tico"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.CloseBubbleCommand}">
                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <TextBlock
                            Margin="0,0,6,0"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.MascotMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,2,6,0"
                            HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.NextTipCommand}"
                            Visibility="{x:Bind ViewModel.HasMoreTips, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Próxima dica" />
                                <FontIcon FontSize="11" Glyph="&#xE76C;" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <!--  Pontinha do balão apontando para o Tico  -->
                <Polygon
                    Margin="0,0,-9,22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    Points="0,0 10,7 0,14" />
            </Grid>

            <Button
                Grid.Column="1"
                Padding="0"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Tico, o especialista. Clique para ouvir a próxima dica."
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.MascotClickedCommand}"
                ToolTipService.ToolTip="Clique para a próxima dica">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                </Button.Resources>
                <Grid>
                    <controls:ExpertMascot
                        x:Name="Mascot"
                        Width="104"
                        Height="111"
                        Mood="{x:Bind ViewModel.MascotMood, Mode=OneWay}" />
                    <!--  Sinal de "tenho mais dicas" quando o balão está fechado  -->
                    <Border
                        Width="26"
                        Height="26"
                        Margin="0,2,2,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderThickness="2"
                        CornerRadius="13"
                        Visibility="{x:Bind ViewModel.ShowTipBadge, Mode=OneWay}">
                        <FontIcon
                            FontSize="11"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE8BD;" />
                    </Border>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Page>
