<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>InstaPanel.App</RootNamespace>
    <AssemblyName>InstaPanel</AssemblyName>
    <Version>0.7.0</Version>
    <!-- Main próprio (Program.cs): o Velopack precisa rodar antes do WinUI para tratar instalação/atualização. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>

    <!-- App desempacotado (sem MSIX), com o runtime do Windows App SDK junto: roda direto do .exe. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Mesmo sem MSIX, é o que leva o InstaPanel.pri e os .xbf (telas compiladas) para o "dotnet publish".
         Sem isso o app instalado fecha ao abrir (erro em Microsoft.UI.Xaml.dll). -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultLanguage>pt-BR</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\NotificationIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstaPanel.Cloud\InstaPanel.Cloud.csproj" />
    <ProjectReference Include="..\InstaPanel.Core\InstaPanel.Core.csproj" />
    <ProjectReference Include="..\InstaPanel.Media\InstaPanel.Media.csproj" />
    <ProjectReference Include="..\InstaPanel.Data\InstaPanel.Data.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
  </PropertyGroup>
</Project>
